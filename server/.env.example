# ─── Pro-Collab Server Environment Variables ───
# Copy this file to .env and fill in your values

# MongoDB Atlas Connection String (free at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pro-collab?retryWrites=true&w=majority

# JWT Secret — use any long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port (Render sets this automatically)
PORT=5000

# Client URL (your Vercel frontend URL)
CLIENT_URL=https://your-app.vercel.app
