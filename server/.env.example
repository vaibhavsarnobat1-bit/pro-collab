# ─── Pro-Collab Server Environment Variables ───
# Copy this file to .env and fill in your values

# MongoDB Atlas Connection String (free at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pro-collab?retryWrites=true&w=majority

# JWT Secret — use any long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port (Render sets this automatically)
PORT=5000

# Client URL (your Vercel frontend URL)
CLIENT_URL=https://your-app.vercel.app

# ─── AI assistant ───────────────────────────────────────────
# Optional. With no key the assistant still works and answers from the offline
# engine (static analysis + a snippet library). /api/ai/status reports which
# engine is live, and the panel labels it honestly.
#
# Set any one of the free-tier keys below and that model becomes available in
# the assistant's model picker. Set several and the visitor can switch between
# them without a restart. GitHub Models uses a personal access token.

# GROQ_API_KEY=gsk_...                # free · Llama 3.3 70B, very fast
# GEMINI_API_KEY=...                  # free · Gemini 2.0 Flash
# CEREBRAS_API_KEY=csk-...            # free · Llama 3.3 70B
# OPENROUTER_API_KEY=sk-or-...        # free · many models (use ":free" variants)
# MISTRAL_API_KEY=...                 # free · Mistral Small
# TOGETHER_API_KEY=...                # free · Llama 3.3 70B Turbo Free
# GITHUB_MODELS_TOKEN=ghp_...         # free · GitHub Models, GPT-4o mini

# Paid options
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# AI_PROVIDER=groq                    # boot default when several keys are set
# AI_MODEL_GROQ=llama-3.3-70b-versatile
# AI_BASE_URL_GROQ=https://api.groq.com/openai/v1

